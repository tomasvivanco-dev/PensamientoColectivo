---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const autores = await getCollection('autores');
  const columnas = (await getCollection('columnas', (c) => !c.data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return autores.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, columnas: columnas.filter((c) => c.data.author.id === entry.id) },
  }));
}

const { entry, columnas } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) =>
  d.toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base title={entry.data.nombre} description={entry.data.cargo}>
  <div class="read">
    <a class="meta" href="/autores">← Autores</a>
    <h1>{entry.data.nombre}</h1>
    {entry.data.cargo && <p class="lead">{entry.data.cargo}</p>}
    <div class="prose"><Content /></div>

    <h2>Columnas</h2>
    <ul class="list">
      {columnas.map((c) => (
        <li>
          <span class="meta">{fmt(c.data.date)}</span>
          <h3><a href={`/columnas/${c.id}`}>{c.data.title}</a></h3>
        </li>
      ))}
      {columnas.length === 0 && <li><p>Sin columnas publicadas.</p></li>}
    </ul>
  </div>
</Base>
