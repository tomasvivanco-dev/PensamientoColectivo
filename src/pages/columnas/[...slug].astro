---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const columnas = await getCollection('columnas', (c) => !c.data.draft);
  return columnas.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const autor = await getEntry('autores', entry.data.author.id);
const fecha = entry.data.date.toLocaleDateString('es-CL', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="read article">
    <a class="meta" href="/columnas">← Columnas</a>
    <h1>{entry.data.title}</h1>
    <div class="byline meta">
      {autor && <a href={`/autores/${autor.id}`}>{autor.data.nombre}</a>}
      · <time datetime={entry.data.date.toISOString()}>{fecha}</time>
    </div>
    <div class="prose"><Content /></div>
    {entry.data.tags.length > 0 && (
      <div class="tags">{entry.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
    )}
  </article>
</Base>
