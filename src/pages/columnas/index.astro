---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

const fmt = (d: Date) =>
  d.toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const columnas = (await getCollection('columnas', (c) => !c.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const items = await Promise.all(
  columnas.map(async (c) => ({
    ...c,
    autor: (await getEntry('autores', c.data.author.id))?.data.nombre ?? '',
  })),
);
---

<Base title="Columnas" description="Todas las columnas de opinión publicadas en Pensamiento Colectivo.">
  <div class="wrap">
    <p class="kicker">Opinión</p>
    <h1>Columnas</h1>
    <ul class="list">
      {items.map((c) => (
        <li>
          <span class="meta">{fmt(c.data.date)} · {c.autor}</span>
          <h3><a href={`/columnas/${c.id}`}>{c.data.title}</a></h3>
          <p>{c.data.summary}</p>
          {c.data.tags.length > 0 && (
            <div class="tags">{c.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
          )}
        </li>
      ))}
      {items.length === 0 && <li><p>Aún no hay columnas publicadas.</p></li>}
    </ul>
  </div>
</Base>
